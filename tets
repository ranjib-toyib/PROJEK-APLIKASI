def page(title, body, **ctx):
    return render_template_string(BASE, title=title, inner=Markup(render_template_string(body, **ctx)))

# ===================================================================== SISWA
@app.route("/")
def home():
    return page("Masuk Ujian", """<div class="w"><div class="card"><h2>Masuk Ujian</h2>
    {% if err %}<p class="err">{{err}}</p>{% endif %}
    <form method="post" action="/masuk">
    <label>Nama lengkap</label><input name="nama" required>
    <label>Kode ujian (6 angka, dari guru)</label><input name="kode" required maxlength="6" inputmode="numeric">
