@app.route("/guru/api/<int:eid>")
@guru
def guru_api(eid):
    total = db().execute("SELECT COUNT(*) FROM questions WHERE exam_id=?", (eid,)).fetchone()[0]
    out = []
    for a in db().execute("SELECT * FROM attempts WHERE exam_id=? ORDER BY mulai", (eid,)):
        n = db().execute("SELECT COUNT(*) FROM answers WHERE attempt_id=? AND jawaban!=''", (a["id"],)).fetchone()[0]
        lalu = int(time.time() - (a["terakhir"] or a["mulai"]))
        st = "Selesai" if a["selesai"] else ("Mengerjakan" if lalu < 60 else "Terputus?")
        out.append(dict(id=a["id"], nama=a["nama"], status=st, terjawab=n, lalu=lalu, nilai=a["nilai"]))
    return jsonify(kode=kode(eid), sisa=sisa_kode(), total=total, siswa=out)

@app.route("/guru/ujian/<int:eid>/toggle")
@guru
def toggle(eid):
    db().execute("UPDATE exams SET aktif=1-aktif WHERE id=?", (eid,)); db().commit()
    return redirect(f"/guru/ujian/{eid}")

@app.route("/guru/ujian/<int:eid>/soal", methods=["POST"])
@guru
def tambah_soal(eid):
    f = request.form
    if f["tipe"] == "pg":
        opsi = [f["o" + h].strip() for h in "ABCD" if f["o" + h].strip()]
        kunci = f["o" + f["kunci_pg"]].strip()
    else:
        opsi, kunci = [], f["kunci_isian"].strip()
    db().execute("INSERT INTO questions(exam_id,tipe,teks,opsi,kunci,poin) VALUES(?,?,?,?,?,?)",
                 (eid, f["tipe"], f["teks"], json.dumps(opsi), kunci, int(f["poin"])))
    db().commit()
    return redirect(f"/guru/ujian/{eid}")

@app.route("/guru/soal/<int:qid>/hapus")
@guru
def hapus_soal(qid):
    q = db().execute("SELECT exam_id FROM questions WHERE id=?", (qid,)).fetchone()
    db().execute("DELETE FROM questions WHERE id=?", (qid,)); db().commit()
    return redirect(f"/guru/ujian/{q['exam_id']}")

@app.route("/guru/hasil/<int:aid>")
@guru
def hasil(aid):
    a = db().execute("SELECT * FROM attempts WHERE id=?", (aid,)).fetchone()
    ans = {r["question_id"]: r["jawaban"] for r in db().execute("SELECT * FROM answers WHERE attempt_id=?", (aid,))}
    rows = [dict(teks=q["teks"], jawab=ans.get(q["id"], ""), kunci=q["kunci"],
                 ok=benar(q, ans.get(q["id"], "")) if q["id"] in ans else False)
            for q in db().execute("SELECT * FROM questions WHERE exam_id=? ORDER BY id", (a["exam_id"],))]
    nilai = a["nilai"] if a["selesai"] else hitung_nilai(aid, a["exam_id"])
    return page("Detail", """<div class="w"><a href="/guru/ujian/{{a.exam_id}}">&larr; Kembali</a>
    <h2>{{a.nama}} &mdash; nilai {{nilai}}{{'' if a.selesai else ' (sementara)'}}</h2><div class="card"><table>
    <tr><th>Soal</th><th>Jawaban siswa</th><th>Kunci</th><th></th></tr>
    {% for r in rows %}<tr><td>{{r.teks}}</td><td>{{r.jawab or '-'}}</td><td>{{r.kunci}}</td>
    <td class="{{'ok' if r.ok else 'err'}}">{{'Benar' if r.ok else 'Salah'}}</td></tr>{% endfor %}</table></div></div>""",
        a=a, rows=rows, nilai=nilai)

