    <a href="/guru" style="font-size:13px">Login guru</a></div>""", err=request.args.get("err"))

@app.route("/masuk", methods=["POST"])
def masuk():
    nama = request.form["nama"].strip()[:60]
    k = request.form["kode"].strip()
    for e in db().execute("SELECT * FROM exams WHERE aktif=1"):
        if hmac.compare_digest(k, kode(e["id"])):
            a = db().execute("SELECT * FROM attempts WHERE exam_id=? AND lower(nama)=lower(?)",
                             (e["id"], nama)).fetchone()
            if a and a["selesai"]:
                return redirect("/?err=Anda sudah menyelesaikan ujian ini")
            if not a:
                cur = db().execute("INSERT INTO attempts(exam_id,nama,mulai,terakhir) VALUES(?,?,?,?)",
                                   (e["id"], nama, time.time(), time.time()))
                db().commit(); aid = cur.lastrowid
            else:
                aid = a["id"]
            session["aid"] = aid
            return redirect("/ujian")
    return redirect("/?err=Kode salah atau sudah kedaluwarsa")

def attempt_siswa():
    aid = session.get("aid")
    return db().execute("SELECT * FROM attempts WHERE id=?", (aid,)).fetchone() if aid else None

@app.route("/ujian")
def ujian():
    a = attempt_siswa()
    if not a: return redirect("/")
    if a["selesai"]: return redirect("/selesai")
    e = db().execute("SELECT * FROM exams WHERE id=?", (a["exam_id"],)).fetchone()
    sisa = int(a["mulai"] + e["durasi"] * 60 - time.time())
    if sisa <= 0:
        selesaikan(a); return redirect("/selesai")
    qs = []
    for q in db().execute("SELECT * FROM questions WHERE exam_id=? ORDER BY id", (e["id"],)):
        qs.append(dict(q, opsi=json.loads(q["opsi"] or "[]")))
    ans = {r["question_id"]: r["jawaban"] for r in
           db().execute("SELECT * FROM answers WHERE attempt_id=?", (a["id"],))}
    return page(e["judul"], """<div id="timer">Sisa waktu: <b id="t"></b> &nbsp;|&nbsp; {{a.nama}}</div>
    <div class="w"><h2>{{e.judul}}</h2>
    {% for q in qs %}<div class="card"><b>{{loop.index}}.</b> {{q.teks}}
    {% if q.tipe=='pg' %}{% for o in q.opsi %}
      <label class="opsi"><input type="radio" name="q{{q.id}}" value="{{o}}" data-q="{{q.id}}"
      {{'checked' if ans.get(q.id)==o}}>{{o}}</label>{% endfor %}
    {% else %}<input data-q="{{q.id}}" placeholder="Jawaban singkat" value="{{ans.get(q.id,'')}}">{% endif %}
    </div>{% endfor %}
    <button onclick="kirim()">Kirim Jawaban</button> <span id="st" class="ok"></span></div>
    <script>
    let s={{sisa}}, tm={};
    function simpan(el){fetch('/simpan',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({qid:el.dataset.q,jawaban:el.value})}).then(r=>{
      document.getElementById('st').textContent=r.ok?'Tersimpan':'Gagal menyimpan'});}
    document.querySelectorAll('[data-q]').forEach(el=>{
      el.addEventListener('input',()=>{clearTimeout(tm[el.dataset.q]);tm[el.dataset.q]=setTimeout(()=>simpan(el),500)});});
    function kirim(force){if(force||confirm('Kirim jawaban? Tidak bisa diubah lagi.'))
      fetch('/kirim',{method:'POST'}).then(()=>location='/selesai');}
    setInterval(()=>{s--;if(s<=0){kirim(true);return}
      document.getElementById('t').textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0')},1000);
    setInterval(()=>fetch('/simpan',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}),20000);
    </script>""", a=a, e=e, qs=qs, ans=ans, sisa=sisa)

@app.route("/simpan", methods=["POST"])
def simpan():
    a = attempt_siswa()
    if not a or a["selesai"]: return "", 403
    d = request.get_json(silent=True) or {}
    db().execute("UPDATE attempts SET terakhir=? WHERE id=?", (time.time(), a["id"]))
    if d.get("qid"):
        e = db().execute("SELECT durasi FROM exams WHERE id=?", (a["exam_id"],)).fetchone()
        if time.time() > a["mulai"] + e["durasi"] * 60 + 5: return "", 403
        ok = db().execute("SELECT 1 FROM questions WHERE id=? AND exam_id=?", (d["qid"], a["exam_id"])).fetchone()
        if ok:
            db().execute("INSERT OR REPLACE INTO answers VALUES(?,?,?)", (a["id"], d["qid"], str(d.get("jawaban", ""))[:500]))
    db().commit()
    return "ok"

@app.route("/kirim", methods=["POST"])
def kirim():
    a = attempt_siswa()
    if a: selesaikan(a)
    return "ok"

@app.route("/selesai")
def selesai():
    session.pop("aid", None)
    return page("Selesai", """<div class="w"><div class="card"><h2>Ujian selesai</h2>
    <p>Jawaban Anda telah terkirim. Terima kasih.</p><a class="btn" href="/">Kembali</a></div></div>""")

# ===================================================================== GURU
def guru(f):
    @wraps(f)
    def w(*a, **k):
        if not session.get("guru"): return redirect("/guru/login")
        return f(*a, **k)
    return w

@app.route("/guru/login", methods=["GET", "POST"])
def guru_login():
    err = None
    if request.method == "POST":
        if hmac.compare_digest(request.form["pw"], PASS_GURU):
            session["guru"] = True; return redirect("/guru")
        err = "Password salah"
    return page("Login Guru", """<div class="w"><div class="card"><h2>Login Guru</h2>
    {% if err %}<p class="err">{{err}}</p>{% endif %}
    <form method="post"><input type="password" name="pw" placeholder="Password" required>
    <button>Masuk</button></form></div></div>""", err=err)

@app.route("/guru/keluar")
def guru_keluar():
    session.pop("guru", None); return redirect("/")

