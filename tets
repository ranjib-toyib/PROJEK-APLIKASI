"""
Aplikasi Ujian Online - Flask + SQLite
Jalankan:  pip install flask  ->  python app.py
Siswa : http://IP-KOMPUTER:5000        Guru : http://IP-KOMPUTER:5000/guru
Password guru default: guru123  (ubah lewat variabel lingkungan GURU_PASSWORD)
"""
import os, hmac, hashlib, time, json, sqlite3, secrets
from functools import wraps
from flask import Flask, request, session, redirect, jsonify, g, render_template_string
from markupsafe import Markup

DB = "ujian.db"
WINDOW = 900  # kode berganti setiap 15 menit (detik)
PASS_GURU = os.environ.get("GURU_PASSWORD", "guru123")

if not os.path.exists("secret.key"):
    open("secret.key", "w").write(secrets.token_hex(32))
SECRET = open("secret.key").read().strip()

app = Flask(__name__)
app.secret_key = SECRET

# ---------------------------------------------------------------- database
def db():
    if "db" not in g:
        g.db = sqlite3.connect(DB)
        g.db.row_factory = sqlite3.Row
    return g.db

@app.teardown_appcontext
def close_db(_):
    d = g.pop("db", None)
    if d: d.close()

def init_db():
    c = sqlite3.connect(DB)
    c.executescript("""
    CREATE TABLE IF NOT EXISTS exams(id INTEGER PRIMARY KEY, judul TEXT, durasi INTEGER, aktif INTEGER DEFAULT 1);
    CREATE TABLE IF NOT EXISTS questions(id INTEGER PRIMARY KEY, exam_id INTEGER, tipe TEXT, teks TEXT,
        opsi TEXT, kunci TEXT, poin INTEGER DEFAULT 1);
    CREATE TABLE IF NOT EXISTS attempts(id INTEGER PRIMARY KEY, exam_id INTEGER, nama TEXT, mulai REAL,
        selesai REAL, terakhir REAL, nilai REAL);
    CREATE TABLE IF NOT EXISTS answers(attempt_id INTEGER, question_id INTEGER, jawaban TEXT,
        PRIMARY KEY(attempt_id, question_id));
    """)
    c.commit(); c.close()

# ------------------------------------------------------------ kode 15 menit
def kode(exam_id):
    w = int(time.time() // WINDOW)
    h = hmac.new(SECRET.encode(), f"{exam_id}:{w}".encode(), hashlib.sha256).hexdigest()
    return str(int(h[:8], 16) % 1000000).zfill(6)

def sisa_kode():
    return WINDOW - int(time.time()) % WINDOW

# ------------------------------------------------------------------ penilaian
def norm(s): return " ".join((s or "").lower().split())

def benar(q, jawab):
    if q["tipe"] == "pg":
        return norm(jawab) == norm(q["kunci"])
    return norm(jawab) in [norm(k) for k in q["kunci"].split("|")]

def hitung_nilai(aid, exam_id):
    qs = db().execute("SELECT * FROM questions WHERE exam_id=?", (exam_id,)).fetchall()
    ans = {r["question_id"]: r["jawaban"] for r in
           db().execute("SELECT * FROM answers WHERE attempt_id=?", (aid,))}
    total = sum(q["poin"] for q in qs) or 1
    dapat = sum(q["poin"] for q in qs if q["id"] in ans and benar(q, ans[q["id"]]))
    return round(dapat * 100 / total, 1)

def selesaikan(a):
    if not a["selesai"]:
        db().execute("UPDATE attempts SET selesai=?, nilai=? WHERE id=?",
                     (time.time(), hitung_nilai(a["id"], a["exam_id"]), a["id"]))
        db().commit()

