@app.route("/guru/api/<int:eid>/kode")
@guru
def api_kode(eid):
    ambil_ujian(eid)
    return jsonify(kode=kode(eid), sisa=sisa_kode())

@app.route("/guru/ujian/<int:eid>/toggle", methods=["POST"])
@guru
def toggle(eid):
    ambil_ujian(eid)
    db().execute("UPDATE exams SET aktif=1-aktif WHERE id=?", (eid,))
    db().commit()
    return redirect(f"/guru/ujian/{eid}")

@app.route("/guru/ujian/<int:eid>/soal", methods=["POST"])
@guru
def tambah_soal(eid):
    ambil_ujian(eid)
    f = request.form
    if f["tipe"] == "pg":
        opsi = [f["o" + h].strip() for h in "ABCD" if f["o" + h].strip()]
        kunci = f["o" + f["kunci_pg"]].strip()
        if len(opsi) < 2 or not kunci:
            return "Isi minimal 2 opsi dan pastikan opsi kunci tidak kosong. <a href='javascript:history.back()'>Kembali</a>", 400
    else:
        opsi, kunci = [], f["kunci_isian"].strip()
        if not kunci:
            return "Kunci jawaban harus diisi. <a href='javascript:history.back()'>Kembali</a>", 400
    db().execute("INSERT INTO questions(exam_id,tipe,teks,opsi,kunci,poin) VALUES(?,?,?,?,?,?)",
                 (eid, f["tipe"], f["teks"].strip(), json.dumps(opsi), kunci, max(1, int(f["poin"]))))
    db().commit()
    return redirect(f"/guru/ujian/{eid}")

@app.route("/guru/soal/<int:qid>/hapus", methods=["POST"])
@guru
def hapus_soal(qid):
    q = db().execute("SELECT exam_id FROM questions WHERE id=?", (qid,)).fetchone()
    if not q:
        abort(404)
    db().execute("DELETE FROM questions WHERE id=?", (qid,))
    db().commit()
    return redirect(f"/guru/ujian/{q['exam_id']}")


