import sqlite3, json, hmac
from functools import wraps
from flask import Flask, request, session, redirect, g, render_template_string
from markupsafe import Markup

DB = "ujian.db"
PASS_GURU = "guru321"          

app = Flask(__name__)
app.secret_key = "ganti-kunci-ini"   # dipakai untuk session login


def db():
    if "db" not in g:
        g.db = sqlite3.connect(DB)
        g.db.row_factory = sqlite3.Row
    return g.db

@app.teardown_appcontext
def tutup_db(_):
    d = g.pop("db", None)
    if d:
        d.close()

def init_db():
    c = sqlite3.connect(DB)
    c.executescript("""
    CREATE TABLE IF NOT EXISTS exams(
        id INTEGER PRIMARY KEY, judul TEXT, durasi INTEGER, aktif INTEGER DEFAULT 1);
    CREATE TABLE IF NOT EXISTS questions(
        id INTEGER PRIMARY KEY, exam_id INTEGER, tipe TEXT, teks TEXT,
        opsi TEXT, kunci TEXT, poin INTEGER DEFAULT 1);
    """)
    c.commit()
    c.close()

@app.route("/")
def home():
    return redirect("/guru")

    

