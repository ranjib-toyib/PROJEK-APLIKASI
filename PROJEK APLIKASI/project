def ambil_ujian(eid):
    e = db().execute("SELECT * FROM exams WHERE id=?", (eid,)).fetchone()
    if not e:
        abort(404)
    return e

def kode(exam_id):
    w = int(time.time() // WINDOW)
    h = hmac.new(SECRET.encode(), f"{exam_id}:{w}".encode(), hashlib.sha256).hexdigest()
    return str(int(h[:8], 16) % 1000000).zfill(6)

def sisa_kode():
    return WINDOW - int(time.time()) % WINDOW


